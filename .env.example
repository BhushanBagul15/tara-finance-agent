# PostgreSQL — replace with YOUR connection string (Neon or local). Must be quoted if URL contains &.
# Neon: https://console.neon.tech → Connection string → pooled
# Local: postgresql://tara:tara@localhost:5432/tara  (after: docker compose up -d)
DATABASE_URL="postgresql://USER:PASSWORD@ep-YOUR-PROJECT.region.aws.neon.tech/neondb?sslmode=require"

# OpenAI (required for Tara agent)
OPENAI_API_KEY=sk-...

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Optional: default data directory for ingest
DATA_DIR=./data/sample_x
